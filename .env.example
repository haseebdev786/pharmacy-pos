# SAVE AS: pharmacy-pos/.env.example
# Then COPY this file to pharmacy-pos/.env and fill in the secret.
# .env is never committed to git and never pasted in chat.
#
# DATABASE_URL: Prisma resolves a relative SQLite path from the
# prisma/ folder, so file:./dev.db creates prisma/dev.db.
# Backup = copy prisma/dev.db (while the server is stopped).
DATABASE_URL="file:./dev.db"

# Generate a fresh secret with this command (run it, paste ONLY the
# output here, never share the output with anyone):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT secret for this project than for JobHunt.
BETTER_AUTH_SECRET="PASTE-YOUR-GENERATED-SECRET-HERE"

# Local dev URL. Keep localhost here even for LAN use: the browser
# client uses relative URLs, so phones on shop WiFi still work.
BETTER_AUTH_URL="http://localhost:3000"
